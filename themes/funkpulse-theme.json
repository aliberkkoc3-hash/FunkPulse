  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#637391",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FF6875",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#51B4FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#8BD0FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#73D6A0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#EAF1FF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF6875"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#8BD0FF"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FFD166",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#68E0F5"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation"
      ],
      "settings": {
        "foreground": "#8496B8"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#641522",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#8BD0FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C0A3FF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF6875",
        "background": "#2A0C18"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#73D6A0"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#68E0F5"
      }
    },
    {
      "scope": [
        "entity.name.label",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "scope": [
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#FF6875",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#8BD0FF",
    "interface": "#68E0F5",
    "enum": "#8BD0FF",
    "type": "#8BD0FF",
    "typeParameter": "#C0A3FF",
    "function": "#51B4FF",
    "method": "#51B4FF",
    "parameter": "#68E0F5",
    "variable": "#EAF1FF",
    "property": "#8BD0FF",
    "namespace": "#68E0F5",
    "enumMember": "#FFD166",
    "macro": "#FFD166",
    "keyword": "#FF6875",
    "comment": {
      "foreground": "#637391",
      "italic": true
    },
    "string": "#73D6A0",
    "number": "#FFD166",
    "regexp": "#FF6875",
    "operator": "#51B4FF",
    "decorator": "#FFD166"
  }
}
